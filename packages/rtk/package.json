{
  "name": "@lpr/rtk",
  "author": "MicheL <michel@itneo.fr>",
  "version": "1.0.1",
  "description": "easy use redux-toolkit",
  "type": "module",
  "files": [
    "dist",
    "cli"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./react": {
      "import": "./dist/react.js"
    }
  },
  "bin": {
    "rtk-slice": "./cli/index.mjs",
    "rtk-export": "./cli/export.mjs",
    "rtk-deps": "./cli/deps.mjs",
    "rtk-listeners": "./cli/listeners.mjs"
  },
  "scripts": {
    "build": "vite build",
    "test": "echo \"Error: no test specified\" && exit 1",
    "p": "prettier -w './**/*.{js,jsx,css,scss,ts,mjs,cjs,json,md}'",
    "e": "pnpm eslint --report-unused-disable-directives --max-warnings 0 './**/*.{js,jsx,,mjs,cjs}'",
    "ef": "pnpm eslint --fix './**/*.{js,jsx,,mjs,cjs}'"
  },
  "license": "MIT",
  "dependencies": {
    "@lpr/is-dev-mode": "^0.1.0",
    "@lpr/logger": "^0.0.1",
    "@prettier/sync": "^0.5.1",
    "@reduxjs/toolkit": "^2.12.0",
    "acorn": "^8.11.2",
    "acorn-jsx": "^5.3.2",
    "commander": "^11.0.0",
    "esquery": "^1.5.0",
    "fs": "0.0.1-security",
    "glob": "^11.0.0",
    "inflected": "^2.1.0",
    "react": "19",
    "redux": "^5.0.1",
    "use-sync-external-store": "^1.6.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^8.41.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-n": "^16.0.0",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "madge": "^6.1.0",
    "prettier": "^3.2.5",
    "vite": "^8.0.14"
  }
}

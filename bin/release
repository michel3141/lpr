#!/bin/bash
# Publie une version d'une lib du dépôt.
#
#   bin/release <lib>             version calculée par cz, commit, tag, pnpm publish
#   bin/release <lib> --dry-run   affiche ce qui serait fait, sans rien écrire
#
# D'habitude lancé par make release-plan / make release depuis packages/<lib>.
#
# Fonctionnement
#
# 1. Vérifications. La lib existe, le dépôt est propre (cz bump commite tout fichier
#    modifié) et on est sur main. Chaque lib du dépôt dont elle dépend (workspace:) doit
#    être publiée dans sa version actuelle, taguée, sans commit à son scope depuis ce
#    tag : la version publiée de <lib> demandera cette version, qui doit donc exister.
#
# 2. cz (commitizen), en une commande, avec la configuration tirée de cz.toml.in :
#    - lit les commits depuis le dernier tag <lib>@x.y.z ; seuls feat, fix, perf et
#      refactor au scope de la lib comptent (feat(<lib>): …) ;
#    - en déduit la version : fix et perf → patch, feat → minor, rupture (!) → major,
#      ou minor tant que la lib est en 0.x ;
#    - l'écrit dans package.json, ajoute en tête du CHANGELOG.md une section rangée
#      par type (titres des commits seulement) ;
#    - commite chore(<lib>): version x.y.z et pose le tag annoté <lib>@x.y.z.
#
# 3. pnpm publish envoie la lib (sa liste files, package.json, README, LICENSE) au
#    registre @lpr du .npmrc, jeton dans ~/.npmrc ; les workspace:^ y deviennent
#    ^<version actuelle>.
#
# Reste à faire : git push (push.followTags envoie le tag).
#
# Pas atomique : commit et tag précèdent la publication. Si pnpm publish échoue, relancer
# pnpm publish dans packages/<lib> (make release répondrait « rien à faire »).

set -euo pipefail

usage="usage : bin/release <lib> [--dry-run]"
lib=${1:?$usage}
mode=${2:-}
CZ=${CZ:-cz}

cd "$(dirname "$0")/.."
root=$PWD
lib_dir=$root/packages/$lib

die() {
  echo "$*" >&2
  exit 1
}

# Version actuelle d'une lib, lue dans son package.json.
version_of() {
  jq -r .version "$root/packages/$1/package.json"
}

# Libs du dépôt dont <lib> dépend (dépendances en workspace:).
workspace_deps() {
  jq -r '
    [.dependencies, .peerDependencies, .optionalDependencies]
    | map((. // {}) | to_entries[] | select(.value | startswith("workspace:")) | .key)
    | unique[]
  ' "$lib_dir/package.json"
}

# Vrai si <dep> a des commits à son scope (feat, fix, perf, refactor) depuis <tag>.
has_unreleased_commits() {
  local dep=$1 tag=$2
  # Pas de grep -q : avec pipefail, il fermerait le tube et ferait échouer git log.
  git log --format=%s "$tag..HEAD" | grep -E "^(feat|fix|perf|refactor)\($dep\)" >/dev/null
}

# Vrai si <paquet>@<version> est sur le registre (pnpm view n'affiche rien sinon).
is_published() {
  local package=$1 version=$2
  [ "$(pnpm view "$package@$version" version 2>/dev/null)" = "$version" ]
}

# Tags des autres libs, au format attendu par ignored_tag_formats de cz :
# "logger@$version", "rtk@$version"…
other_tag_formats() {
  ls "$root/packages" | grep -vx "$lib" | sed 's/.*/"&@$version"/' | paste -sd, | sed 's/,/, /g'
}

# --- Vérifications -----------------------------------------------------------------------

[ -f "$lib_dir/package.json" ] || die "lib inconnue : $lib"

# cz bump commite tout fichier modifié : le dépôt doit être propre.
[ -z "$(git status --porcelain)" ] || die "dépôt modifié : commiter ou remiser d'abord"

[ "$(git branch --show-current)" = main ] || die "pas sur main"

# Une dépendance du dépôt se publie d'abord : la version publiée de <lib> demandera la
# version actuelle de cette dépendance, qui doit donc exister sur le registre.
for dep_name in $(workspace_deps); do
  dep=${dep_name#@lpr/}
  version=$(version_of "$dep")
  tag=$dep@$version
  is_published "$dep_name" "$version" ||
    die "$dep_name@$version absent du registre, publier $dep d'abord"
  git rev-parse -q --verify "refs/tags/$tag" >/dev/null ||
    die "$dep_name : tag $tag absent"
  ! has_unreleased_commits "$dep" "$tag" ||
    die "$dep_name : commits non publiés depuis $tag, publier $dep d'abord"
done

# --- Configuration de cz -----------------------------------------------------------------

# cz lit ses chemins (CHANGELOG.md) depuis le dossier de sa configuration : elle est écrite
# dans celui de la lib (ignorée par git) et retirée à la fin.
sed -e "s/@LIB@/$lib/g" -e "s/@AUTRES@/$(other_tag_formats)/" "$root/cz.toml.in" \
  > "$lib_dir/.cz.toml"
trap 'rm -f "$lib_dir/.cz.toml"' EXIT

# --- Version, commit, tag, publication ---------------------------------------------------

cd "$lib_dir"
case $mode in
  --dry-run)
    $CZ --config .cz.toml bump --yes --dry-run
    ;;
  "")
    $CZ --config .cz.toml bump --yes
    pnpm publish
    ;;
  *)
    die "$usage"
    ;;
esac

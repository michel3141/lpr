package.json
  "author": "michel3141 <michel3141@wanadoo.fr> (https://github.com/michel3141)",
  "files": [
    "src",
    "react",
    "docs",
    "!**/.*.swp"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./adapter": "./src/adapter/index.js",
    "./actions": "./src/actions.js",
    "./selectors": "./src/selectors.js",
    "./react": "./react/index.js"
  },

*************
$ pn pack --dry-run                         ## pour voir la liste des fichiers publiés
$ pn publish --dry-run  --no-git-checks     ## check la publication
$ pn publish                                ## publication
$ pn unpublish @lpr/package-name@@0.0.0     ## supprimer une publication

